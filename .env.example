# Trade-Idea Critic environment variables.
# Copy to backend/.env for local backend, and frontend/.env.local for the frontend.
# Never commit a populated .env.

# --- Backend (required) ---

# Anthropic API key for Opus + Sonnet. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Postgres connection string. Local docker-compose: postgresql+asyncpg://critic:critic@localhost:5432/critic
DATABASE_URL=postgresql+asyncpg://critic:critic@localhost:5432/critic

# Redis connection string. Local docker-compose: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# SEC EDGAR requires a contact User-Agent: "<your name> <email>".
EDGAR_USER_AGENT=Your Name your.email@example.com

# NewsAPI key (free tier is fine for dev). Get one at https://newsapi.org/.
NEWSAPI_KEY=

# Daily LLM spend cap in USD. Fail-closed when exceeded.
MAX_DAILY_LLM_COST_USD=10.00

# Logging.
LOG_LEVEL=INFO
ENVIRONMENT=dev

# Where LLM cassettes / response cache live on disk.
LLM_CACHE_DIR=./.llm_cache

# Observability.
LOGFIRE_TOKEN=
SENTRY_DSN=

# --- Backend (optional) ---

# Backup market-data provider when yfinance is unavailable.
FINNHUB_API_KEY=

# Slack webhook for ops alerts (cost cap, error rate, etc.).
SLACK_WEBHOOK_URL=

# --- Frontend (frontend/.env.local) ---

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
